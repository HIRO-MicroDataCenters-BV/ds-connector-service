CHUNK_SIZE=8192 # 8KB chunks
MAX_FILE_SIZE=10737418240  # 10 * 1024 * 1024 * 1024  # 10GB limit
MAX_FILES_TO_LIST=10  # Limit for number of files to list in directory listings
FS_BASE_PATH="./data"  # Base path for file system operations

# S3-Compatible Storage Settings (AWS S3, MinIO, etc.)
# Uncomment and set these values for S3 support
# S3_BUCKET_NAME=your-bucket-name
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key
# S3_SESSION_TOKEN=your-session-token  # Optional, for temporary credentials
# S3_REGION=us-east-1
# S3_PREFIX=data/  # Optional prefix for S3 objects (like a folder path)
# S3_ENDPOINT_URL=https://s3.amazonaws.com  # For AWS S3, or your MinIO endpoint (e.g., http://localhost:9000)
